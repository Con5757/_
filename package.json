{
  "name": "underscore-extensionpack",
  "displayName": "Underscore Language Extension",
  "description": "Syntax highlighting, function hover documentation, and snippets for Underscore source and UFG files.",
  "version": "1.1.0",
  "publisher": "con5757",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:underscore"],
  "categories": ["Programming Languages", "Snippets"],
  "contributes": {
    "languages": [
      {
        "id": "underscore",
        "aliases": ["Underscore", "ulang", "u"],
        "extensions": ["._", ".u", ".ufg"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon-light.svg",
          "dark": "./icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "underscore",
        "scopeName": "source._",
        "path": "./syntaxes/_.tmLanguage.json"
      },
      {
        "scopeName": "markdown.underscore.codeblock",
        "path": "./syntaxes/markdown-underscore.tmLanguage.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.underscore": "underscore"
        }
      }
    ],
    "snippets": [
      {
        "language": "underscore",
        "path": "./snippets/snippets.json"
      }
    ]
  }
}
