+static int sectionMatches(const char *line, const char *section) {
+  size_t length = strlen(section);
+  if (strncmp(line, section, length) != 0) return 0;
+  return line[length] == '\0' || line[length] == '\r' ||
+         line[length] == '\n' || line[length] == ' ' ||
+         line[length] == '\t';
+}
+
+static int isAtMarker(const char *line) {
+  const char *cursor;
+  if (line == NULL || line[0] != '@' || line[1] == '\0') return 0;
+  cursor = line + 1;
+  if (*cursor == '&') {
+    ++cursor;
+  } else if (isalpha((unsigned char)*cursor) || *cursor == '_') {
+    while (isalnum((unsigned char)*cursor) || *cursor == '_') ++cursor;
+  } else {
+    return 0;
+  }
+  while (*cursor == ' ' || *cursor == '\t') ++cursor;
+  return *cursor == '\0' || *cursor == '\r' || *cursor == '\n' ||
+         *cursor == ';';
+}
+
+static void updateBraceDepth(int *depth, const char *line) {
+  int inString = 0;
+  int escaped = 0;
+  for (const char *cursor = line; *cursor != '\0'; ++cursor) {
+    if (!inString && *cursor == ';') break;
+    if (inString) {
+      if (escaped) escaped = 0;
+      else if (*cursor == '\\') escaped = 1;
+      else if (*cursor == '"') inString = 0;
+      continue;
+    }
+    if (*cursor == '"') inString = 1;
+    else if (*cursor == '{') ++*depth;
+    else if (*cursor == '}' && *depth > 0) --*depth;
+  }
+}
+
+static void appendUfgSourceLine(char *buffer, size_t *used, const char *line,
+                                int *braceDepth, const char *manifestPath) {
+  size_t length = strlen(line);
+  if (*used + length + 1 > MAX_UFG_CODE_SIZE) {
+    importError("UFG code in `%s` exceeds the %u-byte section limit",
+                manifestPath, (unsigned int)MAX_UFG_CODE_SIZE);
+  }
+  memcpy(buffer + *used, line, length);
+  *used += length;
+  buffer[*used] = '\0';
+  updateBraceDepth(braceDepth, line);
+}
+
+static int isDeclarationNode(ASTNode *node) {
+  return node != NULL &&
+         (node->type == AST_INT_DECL || node->type == AST_FP_DECL ||
+          node->type == AST_STR_DECL || node->type == AST_DECL ||
+          node->type == AST_ARRAY_DECL || node->type == AST_VEC_DECL);
+}
+
+static unsigned long hashUfgPath(const char *text) {
+  unsigned long hash = 2166136261u;
+  for (const unsigned char *cursor = (const unsigned char *)text;
+       *cursor != '\0'; ++cursor) {
+    hash = (hash ^ *cursor) * 16777619u;
+  }
+  return hash & 0xffffffffUL;
+}
+
+static void registerUfgGlobal(const char *sourceName,
+                              const char *generatedName) {
+  for (int i = 0; i < ufgGlobalCount; ++i) {
+    if (strcmp(ufgGlobals[i].sourceName, sourceName) == 0 &&
+        strcmp(ufgGlobals[i].generatedName, generatedName) == 0) {
+      return;
+    }
+  }
+  if (ufgGlobalCount >= MAX_UFG_GLOBALS) {
+    importError("too many UFG global variables (limit %d)", MAX_UFG_GLOBALS);
+  }
+  snprintf(ufgGlobals[ufgGlobalCount].sourceName,
+           sizeof(ufgGlobals[ufgGlobalCount].sourceName), "%s", sourceName);
+  snprintf(ufgGlobals[ufgGlobalCount].generatedName,
+           sizeof(ufgGlobals[ufgGlobalCount].generatedName), "%s",
+           generatedName);
+  ++ufgGlobalCount;
+}
+
+static void mangleUfgGlobalDeclarations(ASTNode *nodes,
+                                        const char *manifestPath) {
+  unsigned long hash = hashUfgPath(manifestPath);
+  for (ASTNode *node = nodes; node != NULL; node = node->next) {
+    char original[MAX_NAME];
+    char generated[MAX_NAME];
+    if (!isDeclarationNode(node) || node->name[0] == '\0') continue;
+    snprintf(original, sizeof(original), "%s", node->name);
+    /* `_u` + eight hex digits + `_` leaves 52 characters for the name. */
+    if (strlen(original) + 11 >= MAX_NAME) {
+      importError("UFG global `%s` is too long to qualify safely", original);
+    }
+    snprintf(generated, sizeof(generated), "_u%08lx_%s", hash, original);
+    registerUfgGlobal(original, generated);
+    snprintf(node->name, sizeof(node->name), "%s", generated);
+    node->storageFlags |= DECL_FLAG_GLOBAL;
+  }
+}
+
+static const char *resolveUfgGlobal(const char *sourceName) {
+  const char *resolved = NULL;
+  for (int i = 0; i < ufgGlobalCount; ++i) {
+    if (strcmp(ufgGlobals[i].sourceName, sourceName) != 0) continue;
+    if (resolved != NULL &&
+        strcmp(resolved, ufgGlobals[i].generatedName) != 0) {
+      importError("UFG global `&%s` is ambiguous; more than one included "
+                  "manifest declares it", sourceName);
+    }
+    resolved = ufgGlobals[i].generatedName;
+  }
+  return resolved;
+}
+
+static void rewriteUfgReferences(ASTNode *node) {
+  for (ASTNode *currentNode = node; currentNode != NULL;
+       currentNode = currentNode->next) {
+    if (currentNode->type == AST_VAR && currentNode->name[0] == '&') {
+      const char *replacement = resolveUfgGlobal(currentNode->name + 1);
+      if (replacement == NULL) {
+        importError("UFG global `%s` has no declaration under `@&` in an "
+                    "included manifest", currentNode->name);
+      }
+      snprintf(currentNode->name, sizeof(currentNode->name), "%s", replacement);
+    }
+    rewriteUfgReferences(currentNode->child);
+    rewriteUfgReferences(currentNode->right);
+    rewriteUfgReferences(currentNode->third);
+    rewriteUfgReferences(currentNode->body);
+    /* Method bodies live on Method, not necessarily on ASTNode->child. */
+    if (currentNode->type == AST_METHOD && currentNode->method != NULL) {
+      rewriteUfgReferences(currentNode->method->body);
+    }
+  }
+}
+
+static void parseManifestCode(const char *manifestPath, char *code,
+                              int containsVariables, const char *manifestName,
+                              const char *projectDirectory,
+                              const char *executableDirectory, ASTNode **first,
+                              ASTNode **last, int depth) {
+  char *source;
+  ASTNode *fragment;
+  ASTNode *expanded;
+  if (code == NULL || code[0] == '\0') return;
+  source = (char *)malloc(strlen(code) + 1);
+  if (source == NULL) importError("out of memory while reading UFG code");
+  strcpy(source, code);
+  diagnosticSetSource(manifestPath, source);
+  lex(source);
+  fragment = parseProgram();
+  if (containsVariables) mangleUfgGlobalDeclarations(fragment->child, manifestPath);
+  expanded = expandProgram(fragment, projectDirectory, executableDirectory,
+                           manifestName, 0, depth + 1);
+  appendNodeChain(first, last, expanded);
+  free(source);
+}
+
+static const char *lastPathPart(const char *path) {
+  const char *slash = strrchr(path, '/');
+  const char *backslash = strrchr(path, '\\');
+  if (backslash != NULL && (slash == NULL || backslash > slash)) slash = backslash;
+  return slash == NULL ? path : slash + 1;
+}
+
+static void loadManifestEntry(const char *entry, const char *folder,
+                              int legacyLayout, const char *projectDirectory,
+                              const char *executableDirectory, ASTNode **first,
+                              ASTNode **last, int depth) {
+  char relativePath[IMPORT_PATH_SIZE];
+  char root[IMPORT_PATH_SIZE];
+  char rootWithPackage[IMPORT_PATH_SIZE];
+  char module[MAX_NAME];
+  char namespaceName[MAX_NAME];
+  char *leaf;
+  char *separator;
+  size_t length;
+
+  copyPath(relativePath, entry);
+  for (char *cursor = relativePath; *cursor != '\0'; ++cursor) {
+    if (*cursor == '\\') *cursor = '/';
+  }
+  if (relativePath[0] == '/' ||
+      (isalpha((unsigned char)relativePath[0]) && relativePath[1] == ':')) {
+    importError("manifest paths must be relative to the UFG file: `%s`", entry);
+  }
+  leaf = (char *)lastPathPart(relativePath);
+  length = strlen(leaf);
+  if (length < 3 || strcmp(leaf + length - 2, "._") != 0) {
+    importError("manifest file entry must end in `._`: `%s`", entry);
+  }
+  if (length - 2 >= sizeof(module)) {
+    importError("module name in manifest is too long: `%s`", entry);
+  }
+  memcpy(module, leaf, length - 2);
+  module[length - 2] = '\0';
+
+  separator = strrchr(relativePath, '/');
+  if (separator == NULL) {
+    copyPath(root, ".");
+    snprintf(namespaceName, sizeof(namespaceName), "%s",
+             legacyLayout ? folder : module);
+  } else {
+    size_t rootLength = (size_t)(separator - relativePath);
+    if (rootLength == 0 || rootLength >= sizeof(root)) {
+      importError("invalid relative path in manifest: `%s`", entry);
+    }
+    memcpy(root, relativePath, rootLength);
+    root[rootLength] = '\0';
+    const char *parent = lastPathPart(root);
+    if (strlen(parent) >= sizeof(namespaceName)) {
+      importError("namespace in manifest path is too long: `%s`", entry);
+    }
+    snprintf(namespaceName, sizeof(namespaceName), "%s", parent);
+  }
+
+  if (legacyLayout) {
+    if (strcmp(root, ".") == 0) {
+      copyPath(rootWithPackage, folder);
+    } else {
+      joinPath(rootWithPackage, folder, root);
+    }
+    copyPath(root, rootWithPackage);
+  }
+
+  loadModule(root, module, namespaceName, projectDirectory,
+             executableDirectory, first, last, depth + 1);
+}
 
