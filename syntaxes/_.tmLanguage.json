{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "underscore",
  "scopeName": "source._",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#imports" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#library-members" },
    { "include": "#typed-functions" },
    { "include": "#pointers" },
    { "include": "#flags" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "Multiline comment",
          "name": "comment.block.underscore",
          "begin": "!\\.\\.",
          "end": "\\.\\.!",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.underscore"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.underscore"
            }
          }
        },
        {
          "comment": "Single-line comment",
          "name": "comment.line.underscore",
          "begin": "\\.\\.",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.underscore"
            }
          }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.underscore",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.underscore"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.underscore"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.underscore",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.underscore",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.underscore"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.underscore"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.underscore",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "imports": {
      "patterns": [
        {
          "comment": "Library import such as ?std",
          "name": "keyword.control.import.underscore",
          "match": "\\?[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "comment": "Import keyword",
          "name": "keyword.control.import.underscore",
          "match": "\\bwith\\b"
        },
        {
          "comment": "Library names",
          "name": "entity.name.type.module.underscore",
          "match": "\\b(terminal|boolean|math|string|file)\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "comment": "Control-flow keywords",
          "name": "keyword.control.underscore",
          "match": "\\b(if|elif|else|during|repeat|switch|arg|incase|attempt|break|continue|main)\\b"
        },
        {
          "comment": "Function control keywords",
          "name": "keyword.control.underscore",
          "match": "\\b(retreat|kill)\\b"
        },
        {
          "comment": "Constant declaration",
          "name": "storage.type.underscore",
          "match": "\\b(const|static|global)\\b"
        },
        {
          "comment": "Boolean values",
          "name": "constant.language.boolean.underscore",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "comment": "Class declaration",
          "name": "storage.type.class.underscore",
          "match": "\\bclass\\b"
        },
        {
          "comment": "Struct declaration",
          "name": "storage.type.struct.underscore",
          "match": "\\bdata\\b"
        },
        {
          "comment": "Enum declaration",
          "name": "storage.type.enum.underscore",
          "match": "\\bset\\b"
        },
        {
          "comment": "Type alias declaration",
          "name": "storage.type.alias.underscore",
          "match": "\\balias\\b"
        },
        {
          "comment": "Access and declaration modifiers",
          "name": "storage.modifier.underscore",
          "match": "\\b(public|private|protected|hidden)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "comment": "Built-in types",
          "name": "storage.type.underscore",
          "match": "\\b(int|fp|str|void)\\b"
        },
        {
          "comment": "Fixed-width integer declaration such as int64@name",
          "match": "\\b(int)(8|16|32|64)(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.underscore"
            },
            "2": {
              "name": "constant.numeric.bitwidth.underscore"
            },
            "3": {
              "name": "storage.type.symbol.underscore"
            },
            "4": {
              "name": "variable.other.typed.underscore"
            }
          }
        },
        {
          "comment": "Fixed-width floating-point declaration such as fp64@name",
          "match": "\\b(fp)(8|16|32|64)(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.underscore"
            },
            "2": {
              "name": "constant.numeric.bitwidth.underscore"
            },
            "3": {
              "name": "storage.type.symbol.underscore"
            },
            "4": {
              "name": "variable.other.typed.underscore"
            }
          }
        },
        {
          "comment": "Fixed-width string declaration such as str64@name",
          "match": "\\b(str)(8|16|32|64)(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.underscore"
            },
            "2": {
              "name": "constant.numeric.bitwidth.underscore"
            },
            "3": {
              "name": "storage.type.symbol.underscore"
            },
            "4": {
              "name": "variable.other.typed.underscore"
            }
          }
        }
      ]
    },

    "library-members": {
      "patterns": [
        {
          "comment": "Standard I/O methods",
          "match": "\\b(std)\\.(out|in|nl)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.module.underscore"
            },
            "2": {
              "name": "support.function.io.underscore"
            }
          }
        },
        {
          "comment": "String functions",
          "name": "support.function.string.underscore",
          "match": "\\b(length|copy|overwrite|compare|subSearch|slice|sliceArray|join|up|low|trim)\\b(?=\\s*\\()"
        }
      ]
    },

    "typed-functions": {
      "patterns": [
        {
          "comment": "Typed function declaration",
          "match": "\\b(int|fp|str|void)\\s+(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.underscore"
            },
            "2": {
              "name": "storage.type.keyword.underscore"
            },
            "3": {
              "name": "entity.name.function.underscore"
            }
          }
        }
      ]
    },

    "pointers": {
      "patterns": [
        {
          "comment": "Pointer/address operators",
          "name": "keyword.operator.pointer.underscore",
          "match": "-->|->|<--|<-|@"
        }
      ]
    },

    "flags": {
      "patterns": [
        {
          "comment": "Function flags such as <void>, <int>, or <>",
          "name": "meta.function.flags.underscore",
          "begin": "<(?=[^\\n>]*>)",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.flags.begin.underscore"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.flags.end.underscore"
            }
          },
          "patterns": [
            {
              "name": "storage.type.underscore",
              "match": "\\b(int|fp|str|void)\\b"
            }
          ]
        },
        {
          "comment": "Command flags such as -silent",
          "name": "entity.name.tag.flag.underscore",
          "match": "(?<![a-zA-Z0-9_])-+[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "comment": "Arithmetic operators",
          "name": "keyword.operator.arithmetic.underscore",
          "match": "\\+|\\-|\\*|/|%"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "comment": "Binary boolean values",
          "name": "constant.numeric.boolean.underscore",
          "match": "\\b[01]\\b"
        },
        {
          "comment": "Numbers",
          "name": "constant.numeric.underscore",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "comment": "Function keyword",
          "name": "storage.type.keyword.underscore",
          "match": "\\bfunc\\b"
        },
        {
          "comment": "Function calls",
          "name": "entity.name.function.underscore",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    }
  }
}