{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Underscore",
  "scopeName": "source._",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#function-calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.underscore",
          "begin": ";-",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.underscore"
            }
          },
          "end": "-;",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.underscore"
            }
          }
        },
        {
          "name": "comment.line.double-slash.underscore",
          "match": "(;).*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.underscore",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.underscore"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.underscore"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.underscore",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.underscore",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.underscore",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.underscore",
          "match": "\\b(if|elif|else|switch|arg|incase|during|repeat|attempt|break|cont|retreat|kill|main)\\b"
        },
        {
          "name": "keyword.declaration.underscore",
          "match": "\\b(int|fp|str|void|func|const|static|global|data|set|alias|class|public|private|hidden|vec)\\b"
        },
        {
          "name": "keyword.import.underscore",
          "match": "\\b(with)\\b|\\?"
        },
        {
          "name": "keyword.operator.underscore",
          "match": "(==|!=|<=|>=|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|/=|%=|->|<-|-->|<--|::|[+*/%=&|^~!<>])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.underscore",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.underscore",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.underscore",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:(?:\\.|::)[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*\\()"
        }
      ]
    }
  }
}
