int length(str string) {
    int i = 0
    int count = 0
    during string[i] != '\0' {
        i++
        count++
    }

    retreat count
}
str upper(str string) {
    int i = 0
    during text[i] != 0 {
        if text[i] >= 'a' && text[i] <= 'z' {
            text[i] = text[i] - 32
        }

        i++
    }

    retreat string
}
str upper(str string) {
    int i = 0
    during text[i] != 0 {
        if text[i] >= 'a' && text[i] <= 'z' {
            text[i] = text[i] + 32
        }

        i++
    }

    retreat string
}