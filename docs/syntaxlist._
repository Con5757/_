..arithmatic
+
-
*
/
% ..modulo
>
<
=>
<=

..logical
|| ..or
&& ..and
~ ..xor

! ..not
!| ..nor
!& ..nand
!~ ..xnor

..types
int name
str name
fp[size] name
void name

..pointers
-> ..ptr reference pointer
<- ..deptr dereference pointer
--> ..dptr or double pointer
<-- ..ddeptr or double dereference pointer

@ ..the at symbol is used in some contexts for its literal meaning of 'at'

..fixed types
..int
int64@name
int32@name
int16@name
int8@name

..conditional
if 
elif
else

count ..change
arg
end

..function keywords
func
retreat
main
kill
(params)
<func flags>

..main structure
void func main() <void> {
    kill
}

..vector params/func flags
!..
go to document: docs/functions/vectorparams.md
..!

..kill flags
!..
go to document: docs/functions/killflags.md
..!

..imports/includes
?lib ..not an actual library just a placeholder
    with lib ..including a lib from a verified external or std

?rootFolder ..the folder which the external lib is found or another file
    with "dir/file.u" ..you MUST have the quotes so the compiler doesnt skip the file in the usage case of '../'