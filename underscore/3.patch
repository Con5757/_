+        codegenError("E4002", "__io_out accepts one argument", node, NULL,
+                     "call the standard-library `io.out` wrapper.");
       }
       emitOutputCall(arg, output);
       return;
@@ -421,2 +458,3 @@
-    emitCName(output, name);
+    if (node->method != NULL) emitMethodCName(output, node->method);
+    else emitCName(output, name);
     fputc('(', output);
@@ -1033,4 +1071,4 @@
   emitFunctionFlags(output, method);
   fprintf(output, "%s ", cType(method->returnType));
-  emitCName(output, method->name);
+  emitMethodCName(output, method);
   fputc('(', output);
@@ -1079,4 +1117,4 @@
     emitFunctionFlags(output, method);
     fprintf(output, "%s ", cType(method->returnType));
-    emitCName(output, method->name);
+    emitMethodCName(output, method);
