+    int isIoCharin = strcmp(name, "__io_charin") == 0;
 
     if (isIoOut) {
       ASTNode *arg = node->child;
-      if (arg == NULL || arg->next != NULL) {
-        codegenError("E4002", "io.out expects exactly one argument", node, NULL,
-                     "write `io.out(value)` with one value.");
+      if (arg == NULL) {
