@@ -172,24 +172,57 @@
 static ASTNode *findFunction(const char *name) {
   for (int i = 0; i < functionCount; ++i) {
     if (strcmp(functions[i].name, name) == 0)
       return functions[i].node;
   }
   return NULL;
 }
 
+static int overloadWidth(Type type) {
+  if (type.width > 0) return type.width;
+  return type.kind == TYPE_INT || type.kind == TYPE_FP ? 32 : 0;
+}
+
+static int sameFunctionSignature(const Method *left, const Method *right) {
+  if (left == NULL || right == NULL || left->paramCount != right->paramCount)
+    return 0;
+  for (int i = 0; i < left->paramCount; ++i) {
+    if (left->params[i].type.kind != right->params[i].type.kind ||
+        overloadWidth(left->params[i].type) != overloadWidth(right->params[i].type) ||
+        ((left->params[i].storageFlags ^ right->params[i].storageFlags) &
+         (DECL_FLAG_POINTER | DECL_FLAG_DOUBLE_POINTER)) != 0)
+      return 0;
+  }
+  return 1;
+}
+
+static int functionOverloadCount(const char *name) {
+  int count = 0;
+  for (int i = 0; i < functionCount; ++i)
+    if (strcmp(functions[i].name, name) == 0) ++count;
+  return count;
+}
