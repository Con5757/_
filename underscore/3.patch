+static ASTNode *resolveFunctionOverload(ASTNode *call, int *ambiguous) {
+  int argumentCount = 0;
+  int bestScore = -1;
+  ASTNode *best = NULL;
+  if (ambiguous != NULL) *ambiguous = 0;
+  for (ASTNode *arg = call->child; arg != NULL; arg = arg->next)
+    ++argumentCount;
+
+  for (int i = 0; i < functionCount; ++i) {
+    ASTNode *candidate = functions[i].node;
+    Method *method = candidate != NULL ? candidate->method : NULL;
+    if (method == NULL || strcmp(method->name, call->name) != 0 ||
+        method->paramCount != argumentCount)
+      continue;
+
+    int score = 0;
+    int valid = 1;
+    ASTNode *arg = call->child;
+    for (int p = 0; p < method->paramCount; ++p, arg = arg->next) {
+      ValueType actual = checkExpression(arg);
+      ValueType expected = valueTypeFromType(method->params[p].type);
+      int expectedDepth =
+          (method->params[p].storageFlags & DECL_FLAG_DOUBLE_POINTER) ? 2 :
+          (method->params[p].storageFlags & DECL_FLAG_POINTER) ? 1 : 0;
+      int actualDepth =
+          (arg->storageFlags & DECL_FLAG_DOUBLE_POINTER) ? 2 :
+          (arg->storageFlags & DECL_FLAG_POINTER) ? 1 : 0;
+      int nullPointer = arg->type == AST_NUM &&
+                        arg->valueType == VALUE_INT && arg->value == 0;
+      if ((actualDepth != expectedDepth &&
+           !(expectedDepth > 0 && nullPointer)) ||
+          !typesCompatible(expected, actual)) {
+        valid = 0;
+        break;
+      }
+      if (expected == actual &&
+          (expected == VALUE_INT || expected == VALUE_FP)) {
+        int expectedWidth = method->params[p].type.width > 0
+                                ? method->params[p].type.width : 32;
+        int actualWidth = (arg->declaredType.kind == TYPE_INT ||
+                           arg->declaredType.kind == TYPE_FP) &&
+                                  arg->declaredType.width > 0
+                              ? arg->declaredType.width : 32;
+        if (actualWidth > expectedWidth) {
+          valid = 0;
+          break;
+        }
+        score += actualWidth == expectedWidth ? 4 : 2;
+      } else {
+        score += expected == actual ? 4 : 1;
+      }
+      if (expectedDepth > 0 && nullPointer) score -= 1;
+    }
+    if (!valid) continue;
+    if (score > bestScore) {
+      best = candidate;
+      bestScore = score;
+      if (ambiguous != NULL) *ambiguous = 0;
+    } else if (score == bestScore) {
+      if (ambiguous != NULL) *ambiguous = 1;
+    }
+  }
+  return best;
+}
+
