diff --git a/underscore/compiler/codegen/codegen.c b/underscore/compiler/codegen/codegen.c
--- a/underscore/compiler/codegen/codegen.c
+++ b/underscore/compiler/codegen/codegen.c
@@ -12,10 +12,43 @@
 static void emitCName(FILE *output, const char *name) {
   for (const char *p = name != NULL ? name : ""; *p != '\0'; ++p) {
     if (*p == '.' || *p == ':')
       fputc('_', output);
     else
       fputc((unsigned char)*p, output);
   }
 }
 
+static int methodHasOverloads(const Method *method) {
+  int count = 0;
+  for (ASTNode *node = topLevelNodes; node != NULL; node = node->next) {
+    if (node->type == AST_METHOD && node->method != NULL &&
+        strcmp(node->method->name, method->name) == 0) ++count;
+  }
+  return count > 1;
+}
+
+static void emitMethodCName(FILE *output, const Method *method) {
+  emitCName(output, method->name);
+  if (!methodHasOverloads(method)) return;
+  fputs("__", output);
+  if (method->paramCount == 0) {
+    fputc('v', output);
+    return;
+  }
+  for (int i = 0; i < method->paramCount; ++i) {
+    const Param *param = &method->params[i];
+    char typeCode = param->type.kind == TYPE_INT ? 'i' :
+                    param->type.kind == TYPE_FP ? 'f' :
+                    param->type.kind == TYPE_STR ? 's' : 'v';
+    int width = param->type.width;
+    if (width <= 0 &&
+        (param->type.kind == TYPE_INT || param->type.kind == TYPE_FP))
+      width = 32;
+    fprintf(output, "%c%d", typeCode, width);
+    if ((param->storageFlags & DECL_FLAG_DOUBLE_POINTER) != 0) fputc('d', output);
+    else if ((param->storageFlags & DECL_FLAG_POINTER) != 0) fputc('p', output);
+    fputc('_', output);
+  }
+}
+
