From 1cc4e0bf4fe447b90e9a687f17f3ce5873a60003 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Route public IO through overload-resolved std/io._ functions

Target: languages at 5dd99950f4a55e4784447848d4594ba26dba1e39
Apply after 0001-native-io-runtime.patch and 0002-runtime-fragments.patch.

diff --git a/underscore/compiler/imports/imports.c b/underscore/compiler/imports/imports.c
--- a/underscore/compiler/imports/imports.c
+++ b/underscore/compiler/imports/imports.c
@@ -187,13 +187,10 @@
 static int isBuiltinCall(const char *name) {
-  if (name == NULL) return 0;
-  return strcmp(name, "out") == 0 || strcmp(name, "std.out") == 0 ||
-         strcmp(name, "std::out") == 0 || strcmp(name, "in") == 0 ||
-         strcmp(name, "std.in") == 0 || strcmp(name, "io.out") == 0 ||
-         strcmp(name, "io::out") == 0 || strcmp(name, "io.in") == 0 ||
-         strcmp(name, "io::in") == 0 || strcmp(name, "io.errout") == 0 ||
-         strcmp(name, "io::errout") == 0 || strcmp(name, "io.flush") == 0 ||
-         strcmp(name, "io::flush") == 0 || strcmp(name, "io.strout") == 0 ||
-         strcmp(name, "io::strout") == 0 || strcmp(name, "io.charin") == 0 ||
-         strcmp(name, "io::charin") == 0 || strcmp(name, "io.nl") == 0 ||
-         strcmp(name, "io::nl") == 0;
+  if (name == NULL) return 0;
+  if (strncmp(name, "__io_", 5) == 0 ||
+      strncmp(name, "__math_", 7) == 0 ||
+      strncmp(name, "__string_", 9) == 0 ||
+      strcmp(name, "__memory_escape") == 0) return 1;
+  return strcmp(name, "out") == 0 || strcmp(name, "std.out") == 0 ||
+         strcmp(name, "std::out") == 0 || strcmp(name, "in") == 0 ||
+         strcmp(name, "std.in") == 0 || strcmp(name, "io.nl") == 0;
 }
