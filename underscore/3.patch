@@ -850,7 +934,7 @@
-    if (strcmp(expr->name, "io.charin") == 0 || strcmp(expr->name, "io::charin") == 0) {
+    if (strcmp(expr->name, "__io_charin") == 0) {
       if (expr->child != NULL) {
-        semanticErrorAt("E3020", "io.charin expects no arguments", expr, NULL,
-                        "call `io.charin()` without arguments.");
+        semanticErrorAt("E3020", "__io_charin expects no arguments", expr, NULL,
+                        "call `io.charin()` from the standard library.");
       }
       expr->valueType = VALUE_INT;
       return VALUE_INT;
@@ -934,11 +1028,27 @@
       semanticErrorAt("E3022", message, expr,
                       "no function with this name is declared",
                       "check the function name, or declare it with a signature "
                       "such as `int add(int a, int b) { ... }.");
     }
 
+    if (functionOverloadCount(expr->name) > 1) {
+      int ambiguous = 0;
+      functionNode = resolveFunctionOverload(expr, &ambiguous);
+      if (functionNode == NULL) {
