From 0000000000000000000000000000000000000007 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Prevent user code from calling private runtime primitives directly

Target: languages at 5dd99950f4a55e4784447848d4594ba26dba1e39
Apply after 0006-native-file-random-time.patch.

diff --git a/underscore/compiler/semantic/semantic.c b/underscore/compiler/semantic/semantic.c
--- a/underscore/compiler/semantic/semantic.c
+++ b/underscore/compiler/semantic/semantic.c
@@ -475,1 +475,13 @@
+static const char *privateRuntimeOwner(const char *name) {
+  if (name == NULL) return NULL;
+  if (strncmp(name, "__io_", 5) == 0) return "io";
+  if (strncmp(name, "__math_", 7) == 0) return "math";
+  if (strncmp(name, "__file_", 7) == 0) return "file";
+  if (strncmp(name, "__random_", 9) == 0) return "random";
+  if (strncmp(name, "__time_", 7) == 0) return "time";
+  if (strncmp(name, "__string_", 9) == 0) return "string";
+  if (strcmp(name, "__memory_escape") == 0) return "memory";
+  return NULL;
+}
+
 static ValueType checkExpression(ASTNode *expr) {
@@ -487,8 +505,20 @@
   if (expr->type == AST_CALL && strstr(expr->name, "::") != NULL) {
     semanticErrorAt("E3080",
                     "`::` is namespace qualification, not module member access",
                     expr, "this call uses the namespace operator on a module",
                     "use `module.function(...)` for standard-library members; "
                     "namespace declarations and `::` lookup are not implemented yet.");
   }
+  if (expr->type == AST_CALL) {
+    const char *owner = privateRuntimeOwner(expr->name);
+    size_t ownerLength = owner != NULL ? strlen(owner) : 0;
+    if (owner != NULL &&
+        (activeMethod == NULL ||
+         strncmp(activeMethod->name, owner, ownerLength) != 0 ||
+         activeMethod->name[ownerLength] != '.')) {
+      semanticErrorAt("E3096", "private runtime primitive called outside its standard-library wrapper",
+                      expr, "names prefixed with `__` are compiler/runtime implementation details",
+                      "call the documented public API, such as `io.out(value)`, instead.");
+    }
+  }
   ValueType left, right;
