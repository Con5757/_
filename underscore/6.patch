+      {"__memory_escape", "uc_memory_escape"},
+      {"__math_abs", "uc_math_abs"},
+      {"__math_sqrt", "uc_math_sqrt"},
+      {"__math_min", "uc_math_min"},
+      {"__math_max", "uc_math_max"},
+      {"__math_round", "uc_math_round"},
+      {"__math_rdown", "uc_math_rdown"},
+      {"__math_rup", "uc_math_rup"},
+      {"__math_sin", "uc_math_sin"},
+      {"__math_cos", "uc_math_cos"},
+      {"__math_tan", "uc_math_tan"},
+      {"__math_asin", "uc_math_asin"},
+      {"__math_acos", "uc_math_acos"},
+      {"__math_atan", "uc_math_atan"},
+      {"__math_log", "uc_math_log"},
+      {"__math_logx", "uc_math_logx"},
+      {"__math_exp", "uc_math_exp"},
+      {"__math_pi", "uc_math_pi"},
+      {"__file_open", "uc_file_open"},
+      {"__file_create", "uc_file_create"},
+      {"__file_close", "uc_file_close"},
+      {"__file_read", "uc_file_read"},
+      {"__file_write", "uc_file_write"},
+      {"__file_delete", "uc_file_delete"},
+      {"__file_rename", "uc_file_rename"},
+      {"__file_gpath", "uc_file_gpath"},
+      {"__file_gsize", "uc_file_gsize"},
+      {"__random_seed", "uc_random_seed"},
+      {"__random_next", "uc_random_next"},
+      {"__random_range", "uc_random_range"},
+      {"__random_unit", "uc_random_unit"},
+      {"__time_utime", "uc_time_utime"},
+      {"__time_ctime", "uc_time_ctime"},
+      {"__time_utctime", "uc_time_utctime"},
+      {"__time_timedif", "uc_time_timedif"},
   };
diff --git a/underscore/std/file._ b/underscore/std/file._
new file mode 100644
--- /dev/null
+++ b/underscore/std/file._
@@ -0,0 +1,35 @@
+int open(str path, str mode) <void> {
+    retreat __file_open(path, mode)
+}
+
+int create(str path) <void> {
+    retreat __file_create(path)
+}
+
+int close(int handle) <void> {
+    retreat __file_close(handle)
+}
+
+str read(int handle) <void> {
+    retreat __file_read(handle)
+}
+
+int write(int handle, str contents) <void> {
+    retreat __file_write(handle, contents)
+}
+
+int delete(str path) <void> {
+    retreat __file_delete(path)
+}
+
+int rename(str path, str newPath) <void> {
+    retreat __file_rename(path, newPath)
+}
+
+str gpath(int handle) <void> {
+    retreat __file_gpath(handle)
+}
+
+int64 gsize(int handle) <void> {
+    retreat __file_gsize(handle)
+}
diff --git a/underscore/std/random._ b/underscore/std/random._
new file mode 100644
--- /dev/null
+++ b/underscore/std/random._
@@ -0,0 +1,15 @@
