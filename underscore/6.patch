From b27c0b3b4e53f567a9edbfed2d4d6b5700060006 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Bind existing math, file, random and time runtime fragments

Target: languages at 5dd99950f4a55e4784447848d4594ba26dba1e39
Apply after 0005-auto-inference.patch.

diff --git a/underscore/compiler/imports/imports.c b/underscore/compiler/imports/imports.c
--- a/underscore/compiler/imports/imports.c
+++ b/underscore/compiler/imports/imports.c
@@ -187,6 +187,9 @@
   if (name == NULL) return 0;
   if (strncmp(name, "__io_", 5) == 0 ||
       strncmp(name, "__math_", 7) == 0 ||
+      strncmp(name, "__file_", 7) == 0 ||
+      strncmp(name, "__random_", 9) == 0 ||
+      strncmp(name, "__time_", 7) == 0 ||
       strncmp(name, "__string_", 9) == 0 ||
       strcmp(name, "__memory_escape") == 0) return 1;
   return strcmp(name, "out") == 0 || strcmp(name, "std.out") == 0 ||
diff --git a/underscore/compiler/semantic/semantic.c b/underscore/compiler/semantic/semantic.c
--- a/underscore/compiler/semantic/semantic.c
+++ b/underscore/compiler/semantic/semantic.c
@@ -409,5 +409,88 @@
 static ValueType checkExpression(ASTNode *expr);
 static void checkStatement(ASTNode *node);
 static void checkStatementList(ASTNode *node);
+
+typedef struct NativeSignature {
+  const char *name;
+  ValueType result;
+  int count;
+  ValueType first;
+  ValueType second;
+} NativeSignature;
+
+static int checkNativeMathFileRandomTime(ASTNode *expr) {
+  static const NativeSignature signatures[] = {
+      {"__math_abs", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_sqrt", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_min", VALUE_FP, 2, VALUE_FP, VALUE_FP},
+      {"__math_max", VALUE_FP, 2, VALUE_FP, VALUE_FP},
+      {"__math_round", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_rdown", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_rup", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_sin", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_cos", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_tan", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_asin", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_acos", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_atan", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_log", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_logx", VALUE_FP, 2, VALUE_FP, VALUE_FP},
+      {"__math_exp", VALUE_FP, 1, VALUE_FP, VALUE_VOID},
+      {"__math_pi", VALUE_FP, 0, VALUE_VOID, VALUE_VOID},
+      {"__file_open", VALUE_INT, 2, VALUE_STR, VALUE_STR},
+      {"__file_create", VALUE_INT, 1, VALUE_STR, VALUE_VOID},
+      {"__file_close", VALUE_INT, 1, VALUE_INT, VALUE_VOID},
+      {"__file_read", VALUE_STR, 1, VALUE_INT, VALUE_VOID},
+      {"__file_write", VALUE_INT, 2, VALUE_INT, VALUE_STR},
+      {"__file_delete", VALUE_INT, 1, VALUE_STR, VALUE_VOID},
+      {"__file_rename", VALUE_INT, 2, VALUE_STR, VALUE_STR},
+      {"__file_gpath", VALUE_STR, 1, VALUE_INT, VALUE_VOID},
+      {"__file_gsize", VALUE_INT, 1, VALUE_INT, VALUE_VOID},
+      {"__random_seed", VALUE_VOID, 1, VALUE_INT, VALUE_VOID},
+      {"__random_next", VALUE_INT, 0, VALUE_VOID, VALUE_VOID},
+      {"__random_range", VALUE_INT, 2, VALUE_INT, VALUE_INT},
+      {"__random_unit", VALUE_FP, 0, VALUE_VOID, VALUE_VOID},
+      {"__time_utime", VALUE_INT, 0, VALUE_VOID, VALUE_VOID},
+      {"__time_ctime", VALUE_STR, 1, VALUE_INT, VALUE_VOID},
+      {"__time_utctime", VALUE_STR, 1, VALUE_INT, VALUE_VOID},
+      {"__time_timedif", VALUE_INT, 2, VALUE_INT, VALUE_INT},
+  };
+  if (expr == NULL || expr->type != AST_CALL) return 0;
+  const NativeSignature *signature = NULL;
+  for (size_t i = 0; i < sizeof(signatures) / sizeof(signatures[0]); ++i) {
+    if (strcmp(expr->name, signatures[i].name) == 0) {
+      signature = &signatures[i];
+      break;
+    }
+  }
+  if (signature == NULL) return 0;
+
+  ASTNode *args[2] = {expr->child, expr->child != NULL ? expr->child->next : NULL};
+  int actualCount = 0;
+  for (ASTNode *arg = expr->child; arg != NULL; arg = arg->next) ++actualCount;
+  if (actualCount != signature->count) {
+    char message[320];
+    snprintf(message, sizeof(message), "`%s` expects %d argument%s, but got %d",
+             expr->name, signature->count, signature->count == 1 ? "" : "s",
+             actualCount);
+    semanticErrorAt("E3082", message, expr, "native standard-library signature mismatch",
+                    "check the wrapper declaration and pass the documented number of arguments.");
+  }
+  ValueType expected[2] = {signature->first, signature->second};
+  for (int i = 0; i < signature->count; ++i) {
+    ValueType actual = checkExpression(args[i]);
+    if (actual != expected[i] &&
+        !(expected[i] == VALUE_FP && actual == VALUE_INT)) {
+      char message[320];
+      snprintf(message, sizeof(message),
+               "argument %d to `%s` must be `%s`, not `%s`", i + 1,
+               expr->name, valueTypeName(expected[i]), valueTypeName(actual));
+      semanticErrorAt("E3082", message, args[i], "native standard-library type mismatch",
+                      "pass an argument matching the function signature; integer values may widen to fp.");
+    }
+  }
+  expr->valueType = signature->result;
+  return 1;
+}
 
 static ASTNode *resolveFunctionOverload(ASTNode *call, int *ambiguous) {
@@ -856,7 +939,8 @@
       expr->valueType = VALUE_VOID;
       return VALUE_VOID;
     }
 
+    if (checkNativeMathFileRandomTime(expr)) return expr->valueType;
     /*
      * Native IO operations are compiler runtime operations. They must be
      * recognized before findFunction(), so they work without an explicit
