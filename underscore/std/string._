int length(str text) <void> {
    int i = 0
    during (text[i] != 0) {
        i++
    }
    retreat i
}

str up(str text) <void> {
    int i = 0
    during (text[i] != 0) {
        if (text[i] >= 97 && text[i] <= 122) {
            text[i] = text[i] - 32
        }
        i++
    }
    retreat text
}

str low(str text) <void> {
    int i = 0
    during (text[i] != 0) {
        if (text[i] >= 65 && text[i] <= 90) {
            text[i] = text[i] + 32
        }
        i++
    }
    retreat text
}