fp abs(fp x) <void> {
    if (x < 0.0)
        retreat -x
    retreat x
}
fp min(fp a, fp b) <void> {
    if (a < b)
        retreat a
    retreat b
}
fp max(fp a, fp b) <void> {
    if (a > b)
        retreat a
    retreat b
}
fp sqrt(fp x) <void> {
    if (x < 0.0)
        retreat -1.0
    if (x == 0.0 || x == 1.0)
        retreat x

    fp guess = 1.0
    if (x > 1.0)
        guess = x

    repeat (int i = 0, i < 1100, i++) {
        fp next = 0.5 * (guess + x / guess)
        fp 
    }
}