From 9f2d8b68ef541ed6a34b82fca0164f57d7d10005 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Add compile-time auto inference and distinct namespace diagnostics

Target: languages at 5dd99950f4a55e4784447848d4594ba26dba1e39
Apply after 0003-io-library-overloads.patch and 0004-string-memory-stdlib.patch.

diff --git a/underscore/compiler/lex/lex.h b/underscore/compiler/lex/lex.h
--- a/underscore/compiler/lex/lex.h
+++ b/underscore/compiler/lex/lex.h
@@ -26,6 +26,7 @@
   TOKEN_INT,
   TOKEN_STR,
   TOKEN_FP,
   TOKEN_VOID,
+  TOKEN_AUTO,
   TOKEN_IN,
   TOKEN_OUT,
diff --git a/underscore/compiler/lex/lex.c b/underscore/compiler/lex/lex.c
--- a/underscore/compiler/lex/lex.c
+++ b/underscore/compiler/lex/lex.c
@@ -57,5 +57,6 @@
   KEYWORD("str", TOKEN_STR);
   KEYWORD("fp", TOKEN_FP);
   KEYWORD("void", TOKEN_VOID);
+  KEYWORD("auto", TOKEN_AUTO);
   KEYWORD("in", TOKEN_IN);
   KEYWORD("out", TOKEN_OUT);
diff --git a/underscore/compiler/parse/parse.h b/underscore/compiler/parse/parse.h
--- a/underscore/compiler/parse/parse.h
+++ b/underscore/compiler/parse/parse.h
@@ -120,4 +120,5 @@
   DECL_FLAG_POINTER = 1 << 6,
   DECL_FLAG_DOUBLE_POINTER = 1 << 7,
-  DECL_FLAG_STRING_BUFFER = 1 << 8
+  DECL_FLAG_STRING_BUFFER = 1 << 8,
+  DECL_FLAG_AUTO = 1 << 9
 };
diff --git a/underscore/compiler/parse/parse.c b/underscore/compiler/parse/parse.c
--- a/underscore/compiler/parse/parse.c
+++ b/underscore/compiler/parse/parse.c
@@ -333,3 +333,4 @@
 static ASTNode *parseBlock(void);
 static ASTNode *parseDeclaration(int modifiers);
+static ASTNode *parseAutoDeclaration(int modifiers);
 static ASTNode *parseArrayInitializer(void);
@@ -489,4 +490,28 @@
   return node;
 }
 
+static ASTNode *parseAutoDeclaration(int modifiers) {
+  Token *keyword = expect(TOKEN_AUTO);
+  Token *name = expectIdentifier();
+  if (!match(TOKEN_EQUAL)) {
+    parserError("`auto` declaration requires an initializer");
+  }
+  ASTNode *initializer = current()->type == TOKEN_LEFT_SQUARE_PAREN
+                             ? parseArrayInitializer()
+                             : parseAssignment();
+  if (initializer != NULL && initializer->type == AST_ARRAY_DECL) {
+    parserError("`auto` does not infer array element or capacity types yet");
+  }
+  ASTNode *node = newAST(AST_DECL);
+  node->line = keyword->line;
+  node->column = keyword->column;
+  copyText(node->name, name->text);
+  node->declaredType.kind = TYPE_VOID;
+  node->declaredType.width = 0;
+  node->storageFlags = modifiers | DECL_FLAG_AUTO;
+  node->typeSize = 0;
+  node->child = initializer;
+  return node;
+}
+
 ASTNode *parseIntDecl(void) {
@@ -1150,2 +1176,3 @@
-    if (isTypeToken(current()->type) || current()->type == TOKEN_CONST ||
+    if (isTypeToken(current()->type) || current()->type == TOKEN_AUTO ||
+        current()->type == TOKEN_CONST ||
         current()->type == TOKEN_STATIC || current()->type == TOKEN_GLOBAL) {
@@ -1164,1 +1191,3 @@
-      node->child = parseDeclaration(modifiers);
+      node->child = current()->type == TOKEN_AUTO
+                        ? parseAutoDeclaration(modifiers)
+                        : parseDeclaration(modifiers);
@@ -1360,4 +1389,5 @@
   }
 
+  if (current()->type == TOKEN_AUTO) return parseAutoDeclaration(modifiers);
   if (isTypeToken(current()->type)) return parseDeclaration(modifiers);
   if (modifiers != 0) parserError("storage modifier must precede a declaration");
diff --git a/underscore/compiler/semantic/semantic.c b/underscore/compiler/semantic/semantic.c
--- a/underscore/compiler/semantic/semantic.c
+++ b/underscore/compiler/semantic/semantic.c
@@ -1066,9 +1066,58 @@
 static void checkDeclaration(ASTNode *node, int isGlobal) {
   if (node != NULL && node->type == AST_VEC_DECL) {
     semanticErrorAt(
         "E3062", "dynamic vectors are not implemented yet", node,
         "`vec` is recognized, but the runtime has no vector representation",
         "use a fixed-size array such as `int values<3> = [1, 2, 3]` until "
         "vector allocation and resizing are implemented.");
   }
+  int inferAuto = node != NULL &&
+                  (node->storageFlags & DECL_FLAG_AUTO) != 0;
+  if (inferAuto) {
+    if (node->child == NULL) {
+      semanticErrorAt("E3088", "`auto` requires an initializer", node, NULL,
+                      "write `auto name = expression`; inference happens at compile time.");
+    }
+    ValueType inferred = checkExpression(node->child);
+    if (pointerDepthFromFlags(node->child->storageFlags) > 0) {
+      semanticErrorAt("E3089", "`auto` does not infer pointer types", node->child,
+                      "the initializer is a pointer-valued expression",
+                      "declare the pointer type and its `->` or `-->` level explicitly.");
+    }
+    Type inferredType;
+    inferredType.width = 0;
+    if (inferred == VALUE_INT) {
+      inferredType.kind = TYPE_INT;
+      if (node->child->declaredType.kind == TYPE_INT)
+        inferredType.width = node->child->declaredType.width;
+      node->type = AST_INT_DECL;
+    } else if (inferred == VALUE_FP) {
+      inferredType.kind = TYPE_FP;
+      if (node->child->declaredType.kind == TYPE_FP)
+        inferredType.width = node->child->declaredType.width;
+      node->type = AST_FP_DECL;
+    } else if (inferred == VALUE_STR) {
+      if (node->child->type == AST_CALL &&
+          (strcmp(node->child->name, "string.copy") == 0 ||
+           strcmp(node->child->name, "string.connect") == 0 ||
+           strcmp(node->child->name, "string.slice") == 0)) {
+        semanticErrorAt("E3095", "`auto` would copy an owned string into a local buffer",
+                        node->child, "the allocation result would lose its ownership",
+                        "consume the result directly with `memory.escape(...)` or wait for first-class owned-string types.");
+      }
+      inferredType.kind = TYPE_STR;
+      node->type = AST_STR_DECL;
+      node->storageFlags |= DECL_FLAG_STRING_BUFFER;
+      node->typeSize = node->child->type == AST_STRING
+                           ? stringLiteralLength(node->child->strValue)
+                           : MAX_NAME - 1;
+    } else {
+      semanticErrorAt("E3093", "`auto` cannot infer a value from this expression",
+                      node->child, "the initializer has no supported value type",
+                      "use an `int`, `fp`, or `str` expression.");
+    }
+    node->declaredType = inferredType;
+    node->valueType = inferred;
+    node->storageFlags &= ~DECL_FLAG_AUTO;
+  }
   Type type = typeFromNode(node);
@@ -1078,2 +1114,2 @@
-  if (!isGlobal)
+  if (!isGlobal || inferAuto)
     addVariable(node, type, node->storageFlags, arrayCount, isArray);
@@ -1590,6 +1626,7 @@
-    } else if (isDeclarationType(node->type) && node->name[0] != '\0') {
+    } else if (isDeclarationType(node->type) && node->name[0] != '\0' &&
+               (node->storageFlags & DECL_FLAG_AUTO) == 0) {
       Type type = typeFromNode(node);
       int array = node->type == AST_ARRAY_DECL || node->type == AST_VEC_DECL;
       addVariable(node, type, node->storageFlags, node->arrayCount, array);
     }
   }
