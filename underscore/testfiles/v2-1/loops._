; file deliberately uses no main() function
?std
    with io

repeat (int count1 = 0, count1 < 100, count1++) {
    io.out(count1)
}

int count2
during (count2 <= 100) { ; good, caught unidentifier when tested, the error lens needs to be improved though
    io.out(count2)
    count2++
}