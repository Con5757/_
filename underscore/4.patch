From 71f5bc5fdc5be1d2a5b7eaa31437fdb7a49b0004 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Expose string ownership helpers through source-level wrappers

Target: languages at 5dd99950f4a55e4784447848d4594ba26dba1e39
Apply after 0003-io-library-overloads.patch.

diff --git a/underscore/compiler/semantic/semantic.c b/underscore/compiler/semantic/semantic.c
--- a/underscore/compiler/semantic/semantic.c
+++ b/underscore/compiler/semantic/semantic.c
@@ -779,5 +779,97 @@
     }
 
+    if (strcmp(expr->name, "string.up") == 0 ||
+        strcmp(expr->name, "string.low") == 0 ||
+        strcmp(expr->name, "string.trim") == 0) {
+      ASTNode *target = expr->child;
+      if (target == NULL || target->next != NULL) {
+        semanticErrorAt("E3084", "in-place string routine expects one argument",
+                        expr, NULL, "pass exactly one mutable string variable.");
+      }
+      if (checkExpression(target) != VALUE_STR || !isLValue(target) ||
+          isConstLValue(target)) {
+        semanticErrorAt("E3086", "in-place string routine requires mutable storage",
+                        target, "the argument is not a writable string value",
+                        "pass a mutable `str` variable or writable string element, not a literal or constant.");
+      }
+    }
+
+    if (strcmp(expr->name, "memory.escape") == 0) {
+      ASTNode *owned = expr->child;
+      if (owned == NULL || owned->next != NULL || owned->type != AST_CALL ||
+          (strcmp(owned->name, "string.copy") != 0 &&
+           strcmp(owned->name, "string.connect") != 0 &&
+           strcmp(owned->name, "string.slice") != 0)) {
+        semanticErrorAt("E3094", "`memory.escape` requires a direct owned-string result",
+                        expr, "string ownership is not inferred for arbitrary `str` values",
+                        "use `memory.escape(string.copy(text))`, `string.connect(...)`, or `string.slice(...)` directly.");
+      }
+    }
+
+    if (strncmp(expr->name, "__string_", 9) == 0) {
+      int count = 0;
+      ValueType result = VALUE_STR;
+      int stringArgs = 1;
+      int integerArgs = 0;
+      int mutating = 0;
+      if (strcmp(expr->name, "__string_length") == 0) {
+        result = VALUE_INT;
+      } else if (strcmp(expr->name, "__string_copy") == 0) {
+        result = VALUE_STR;
+      } else if (strcmp(expr->name, "__string_up") == 0 ||
+                 strcmp(expr->name, "__string_low") == 0 ||
+                 strcmp(expr->name, "__string_trim") == 0) {
+        result = VALUE_STR;
+        mutating = 1;
+      } else if (strcmp(expr->name, "__string_connect") == 0) {
+        stringArgs = 2;
+        result = VALUE_STR;
+      } else if (strcmp(expr->name, "__string_slice") == 0) {
+        stringArgs = 1;
+        integerArgs = 2;
+        result = VALUE_STR;
+      } else {
+        semanticErrorAt("E3083", "unknown private string runtime operation",
+                        expr, "this private name is not part of the runtime ABI",
+                        "use the public `string` module API from `string._`.");
+      }
+      for (ASTNode *arg = expr->child; arg != NULL; arg = arg->next) ++count;
+      if (count != stringArgs + integerArgs) {
+        semanticErrorAt("E3084", "wrong argument count for string runtime operation",
+                        expr, NULL, "check the matching wrapper in `std/string._`.");
+      }
+      ASTNode *arg = expr->child;
+      for (int i = 0; i < stringArgs + integerArgs; ++i, arg = arg->next) {
+        ValueType actual = checkExpression(arg);
+        ValueType expected = i < stringArgs ? VALUE_STR : VALUE_INT;
+        if (actual != expected) {
+          semanticErrorAt("E3085", "string runtime argument has the wrong type",
+                          arg, "the runtime expects text followed by integer offsets",
+                          "pass a string argument and, where required, integer indices.");
+        }
+      }
+      if (mutating && expr->child != NULL &&
+          (!isLValue(expr->child) || isConstLValue(expr->child))) {
+        semanticErrorAt("E3086", "in-place string operation requires mutable storage",
+                        expr->child, "this argument is not a mutable string variable",
+                        "pass a writable `str` buffer; do not pass a literal or const value.");
+      }
+      expr->valueType = result;
+      return result;
+    }
+
+    if (strcmp(expr->name, "__memory_escape") == 0) {
+      if (expr->child == NULL || expr->child->next != NULL ||
+          checkExpression(expr->child) != VALUE_STR) {
+        semanticErrorAt("E3087", "__memory_escape expects one string pointer",
+                        expr, NULL,
+                        "release only an owned result such as `string.copy` or "
+                        "`string.connect`; never free a literal, local buffer, or borrowed input.");
+      }
+      expr->valueType = VALUE_VOID;
+      return VALUE_VOID;
+    }
+
     /*
      * Native IO operations are compiler runtime operations. They must be
      * recognized before findFunction(), so they work without an explicit
diff --git a/underscore/compiler/codegen/codegen.c b/underscore/compiler/codegen/codegen.c
--- a/underscore/compiler/codegen/codegen.c
+++ b/underscore/compiler/codegen/codegen.c
@@ -45,4 +45,20 @@
   }
 }
 
+static const char *nativeHelperName(const char *name) {
+  static const struct { const char *source; const char *target; } map[] = {
+      {"__string_length", "uc_string_length"},
+      {"__string_copy", "uc_string_copy"},
+      {"__string_connect", "uc_string_connect"},
+      {"__string_slice", "uc_string_slice"},
+      {"__string_up", "uc_string_up"},
+      {"__string_low", "uc_string_low"},
+      {"__string_trim", "uc_string_trim"},
+      {"__memory_escape", "uc_memory_escape"}
+  };
+  for (size_t i = 0; i < sizeof(map) / sizeof(map[0]); ++i)
+    if (strcmp(name, map[i].source) == 0) return map[i].target;
+  return NULL;
+}
+
 static Type nodeType(ASTNode *node) {
@@ -338,3 +354,14 @@
   case AST_CALL: {
     const char *name = node->name;
+    const char *nativeName = nativeHelperName(name);
+    if (nativeName != NULL) {
+      fputs(nativeName, output);
+      fputc('(', output);
+      for (ASTNode *arg = node->child; arg != NULL; arg = arg->next) {
+        if (arg != node->child) fputs(", ", output);
+        generateExpression(arg, output);
+      }
+      fputc(')', output);
+      return;
+    }
     int isIoOut = strcmp(name, "__io_out") == 0;
