{
  "$schema": "[https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json](https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json)",
  "name": "Night Markdown Codeblock",
  "scopeName": "markdown.night.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#markdown-codeblock"
    }
  ],
  "repository": {
    "markdown-codeblock": {
      "begin": "^\\s*(`{3,}|~{3,})\\s*(?i:(night|nightlang|progNight|n))\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.markdown" },
        "2": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "^\\s*(\\1)\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.markdown" }
      },
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.night source.n",
      "patterns": [
        {
          "include": "source.n"
        }
      ]
    }
  }
}
